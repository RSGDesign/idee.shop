# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

!.env.example
backups/
*.local.json

# Extracted pinned ECC source/runtime; archive and pin are versioned
.ecc/upstream/
.ecc/local-home/

# Private persistent database and snapshots
/data/
*.sqlite
*.sqlite-wal
*.sqlite-shm

# Downloaded OAuth credentials and private database exports
client_secret*.json
credentials.json
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
*.p12
*.key

# Machine-specific ECC installation state
.agents/ecc-install-state.json
