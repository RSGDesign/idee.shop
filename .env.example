# Optional persistent SQLite path (default: data/idee-shop.sqlite).
# IDEE_DATABASE_PATH=/absolute/path/to/idee-shop.sqlite

# Optional exact HTTPS origin for a trusted private reverse proxy (no trailing path).
# IDEE_APP_ORIGIN=https://your-device.your-tailnet.ts.net

# Google Calendar OAuth web client, optional. Store actual values in .env.local.
# IDEE_GOOGLE_CLIENT_ID=
# IDEE_GOOGLE_CLIENT_SECRET=
# IDEE_GOOGLE_ORIGIN=http://127.0.0.1:3000
# IDEE_GOOGLE_TIME_ZONE=Europe/Bucharest
